{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read audit details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare Email Body header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Body Header",
					"value": "Ingestion and Transformation process for caresync project has been completed and below is status"
				}
			},
			{
				"name": "Prepare Email Body Footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Body Footer",
					"value": "For any support please reach out to abc@gmail.com"
				}
			},
			{
				"name": "prepare email subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get status based on count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{variables('Status')} |CARESYNCMASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get Status count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as count from ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}' and status!='SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Get status based on count",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get Status count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Status",
					"value": {
						"value": "@{if(equals(activity('Get Status count').output.firstRow.count,0),'SUCCESS','FAILED' )}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Logic apps body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare email subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Body Footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Body header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read audit details",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic apps body",
					"value": {
						"value": "{\n    \"subject\":@{variables('email_subject')},\n    \"email_recipients\":@{pipeline().globalParameters.email_recipient},\n    \"body_header\":@{variables('Body Header')},\n    \"body_footer\":@{variables('Body Footer')},\n    \"status_table\":@{activity('Read audit details').output.value}\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "545d68f3-8f94-45dc-b87d-ab0b98497679"
			}
		},
		"variables": {
			"Body Header": {
				"type": "String"
			},
			"Body Footer": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"Status": {
				"type": "String"
			},
			"logic apps body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}